# Fixtures = donnees de test au niveau octet (BOM, CRLF, UTF-8 invalide...) :
# aucune normalisation git (fins de ligne, BOM) ne doit les modifier.
tests/fixtures/* binary

# Script de test bash : toujours en LF
tests/run.sh text eol=lf

# Script de test cmd : toujours en CRLF (cmd + batch = CRLF, independant de la config git du runner)
tests/run.bat text eol=crlf
